# RANGEWATCH backend — copy to .env only if you need to override defaults.

# Where the range-trader stack keeps its state (heartbeats, ledgers, alerts).
# Defaults to ~/.range-trader
#RANGE_TRADER_DIR=/Users/you/.range-trader

# Demo mode: 1 = every panel runs a scripted synthetic day (no real data read).
#RANGEWATCH_DEMO=1

# Where Claude Code transcripts live (token usage panel). Default ~/.claude/projects
#CLAUDE_PROJECTS_DIR=/Users/you/.claude/projects

# Session-log SQLite path. Demo mode defaults to a throwaway in /tmp.
#RANGEWATCH_SESSIONS_DB=/Users/you/.rangewatch/sessions.db
